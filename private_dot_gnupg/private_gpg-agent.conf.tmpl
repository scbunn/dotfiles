default-cache-ttl 600
max-cache-ttl 7200
{{- $winPinentry := "/mnt/c/Program Files (x86)/GnuPG/bin/pinentry-basic.exe" }}
{{- if eq .chezmoi.os "darwin" }}
{{- $brewPrefix := "/opt/homebrew" }}
{{- if stat (joinPath .chezmoi.homeDir ".homebrew/bin/brew") }}
{{-   $brewPrefix = joinPath .chezmoi.homeDir ".homebrew" }}
{{- else if and (not (stat "/opt/homebrew/bin/brew")) (stat "/usr/local/bin/brew") }}
{{-   $brewPrefix = "/usr/local" }}
{{- end }}
pinentry-program {{ $brewPrefix }}/bin/pinentry-mac
{{- else if contains "microsoft" (.chezmoi.kernel.osrelease | lower) }}
{{- if stat $winPinentry }}
pinentry-program {{ $winPinentry }}
{{- else }}
pinentry-program /usr/bin/pinentry-tty
{{- end }}
{{- else if eq .chezmoi.os "linux" }}
{{- if stat "/usr/bin/pinentry-qt" }}
pinentry-program /usr/bin/pinentry-qt
{{- else }}
pinentry-program /usr/bin/pinentry-tty
{{- end }}
{{- end }}
enable-ssh-support
